{
  "name": "prixsix-whatsapp-worker",
  "version": "2.2.8",
  "description": "WhatsApp notification worker for Prix Six Fantasy F1 (Baileys)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "docker:build": "docker build -t prixsix-whatsapp-worker .",
    "docker:run": "docker run -p 3000:3000 --env-file .env prixsix-whatsapp-worker"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
