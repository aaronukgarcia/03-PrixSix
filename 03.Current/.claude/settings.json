{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node claude-version-guard.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node claude-pre-commit-check.js",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node claude-pre-push-check.js",
            "timeout": 6
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node claude-memory-prefetch.js",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SAFE_HOME\" ] || { echo 'safe-nats hook: SAFE_HOME is not set; start this window from its C:\\bat launcher' >&2; exit 0; }; node \"$SAFE_HOME/tools/nats/hooks/hook.js\" UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node claude-startup.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SAFE_HOME\" ] || { echo 'safe-nats hook: SAFE_HOME is not set; start this window from its C:\\bat launcher' >&2; exit 0; }; node \"$SAFE_HOME/tools/nats/hooks/hook.js\" SessionStart",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"CRITICAL CONTEXT TO PRESERVE: [1] You are bob/bill/ben - prefix ALL responses. [2] Run node claude-sync.js checkin after compaction. [3] Golden Rules: error trapping, version discipline, single source of truth, identity prefix, verbose confirmations, GUID documentation. [4] Never commit to main without version bump in package.json AND version.ts. [5] Read CLAUDE.md for full rules.\""
          },
          {
            "type": "command",
            "command": "node tools/session-ledger.js auto",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node claude-ping-check.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node claude-reflection.js",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SAFE_HOME\" ] || { echo 'safe-nats hook: SAFE_HOME is not set; start this window from its C:\\bat launcher' >&2; exit 0; }; node \"$SAFE_HOME/tools/nats/hooks/hook.js\" PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SAFE_HOME\" ] || { echo 'safe-nats hook: SAFE_HOME is not set; start this window from its C:\\bat launcher' >&2; exit 0; }; node \"$SAFE_HOME/tools/nats/hooks/hook.js\" SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(nats)",
      "Bash(nats *)",
      "PowerShell(nats)",
      "PowerShell(nats *)"
    ],
    "deny": [
      "Read(E:\\SAFE\\nats\\private\\**)",
      "Read(E:\\SAFE\\nats\\consumers\\**)",
      "Bash(*nats\\private*)",
      "PowerShell(*nats\\private*)",
      "Read(E:/SAFE/nats/private/**)",
      "Read(E:/SAFE/nats/consumers/**)",
      "Bash(*nats/private*)",
      "PowerShell(*nats/private*)"
    ]
  },
  "enabledMcpjsonServers": [
    "safe-nats"
  ]
}
