# Logs
# BUG-GITIGNORE-001: anchored — unanchored "logs" matched EVERY directory named logs,
# silently shadowing real source (e.g. src/app/api/admin/logs/ or an admin logs page).
# Same class as the "email/" bug fixed 2026-07-26.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
# BUG-GITIGNORE-001: anchored — see "/logs" note above.
/pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
# BUG-GITIGNORE-001: anchored — unanchored "coverage" shadowed any src dir named coverage.
/coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env*.local

# Test files with secrets — anchored to the app root only. The old unanchored "email/"
# matched EVERY directory named email, including src/app/api/admin/email/, silently
# blocking git add on real source (discovered 2026-07-26 while fixing the Graph probe).
/email/

# Service account keys
**/service-account*.json

# dataconnect generated files
.dataconnect

# TypeScript incremental build info (local build artifact, not for version control)
*.tsbuildinfo

# One-off admin scripts (kept local, not committed)
# BUG-GITIGNORE-001: anchored — the file lives at the app root; unanchored it would also
# shadow any future src file with the same name.
/send-bulk-temp.ts
